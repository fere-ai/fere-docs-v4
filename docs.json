{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Fere AI",
  "description": "Official Fere AI documentation: AI trading agents that each run a unique strategy, agent wallets and security, the Fere MCP for research and trading, points, and FAQ.",
  "colors": {
    "primary": "#EBCB8B",
    "light": "#EBCB8B",
    "dark": "#B8860B"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "https://storage.googleapis.com/fere-assets/logo/logo-dark.webp",
    "dark": "https://storage.googleapis.com/fere-assets/logo/logo-light.webp",
    "href": "/"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "dark": "#050505",
      "light": "#fafafa"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Agents",
        "pages": [
          "agents",
          "wallet"
        ]
      },
      {
        "group": "Research & Trading via MCP",
        "pages": [
          "mcp"
        ]
      },
      {
        "group": "Rewards",
        "pages": [
          "points",
          "refer-and-earn"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "faq",
          "support"
        ]
      },
      {
        "group": "Legal",
        "pages": [
          "legal/terms",
          "legal/privacy",
          "legal/security-policy"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://www.fereai.xyz/agents"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/fere_ai",
      "website": "https://www.fereai.xyz"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Agents",
            "href": "/agents"
          },
          {
            "label": "MCP Support",
            "href": "/mcp"
          }
        ]
      },
      {
        "header": "Resources",
        "items": [
          {
            "label": "FAQ",
            "href": "/faq"
          },
          {
            "label": "Support",
            "href": "/support"
          },
          {
            "label": "Wallet & Security",
            "href": "/wallet"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Terms of Service",
            "href": "/legal/terms"
          },
          {
            "label": "Privacy Policy",
            "href": "/legal/privacy"
          },
          {
            "label": "Security Policy",
            "href": "/legal/security-policy"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/src/_props/:slug*",
      "destination": "/:slug*"
    },
    {
      "source": "/src/_props",
      "destination": "/"
    },
    {
      "source": "/market-pulse",
      "destination": "/"
    },
    {
      "source": "/discover",
      "destination": "/"
    },
    {
      "source": "/polymarket",
      "destination": "/"
    },
    {
      "source": "/hyperliquid",
      "destination": "/"
    },
    {
      "source": "/recipes",
      "destination": "/agents"
    },
    {
      "source": "/strategies",
      "destination": "/agents"
    },
    {
      "source": "/agent",
      "destination": "/agents"
    },
    {
      "source": "/strategy-tools",
      "destination": "/agents"
    },
    {
      "source": "/cross-chain",
      "destination": "/mcp"
    },
    {
      "source": "/credits",
      "destination": "/agents"
    },
    {
      "source": "/subscriptions",
      "destination": "/agents"
    }
  ],
  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://docs.fereai.xyz",
      "og:type": "website",
      "og:site_name": "Fere AI",
      "twitter:card": "summary_large_image",
      "twitter:site": "@fere_ai",
      "robots": "index, follow"
    },
    "organization": {
      "name": "Fere AI",
      "url": "https://www.fereai.xyz",
      "logo": "https://storage.googleapis.com/fere-assets/logo/logo-light.webp",
      "sameAs": [
        "https://x.com/fere_ai",
        "https://www.producthunt.com/products/fere-ai",
        "https://github.com/fere-ai"
      ]
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  }
}
